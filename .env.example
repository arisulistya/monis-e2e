BASE_URL=https://www.monis.rent/
# Set the environment and API origins for delivery-address tests.
MONIS_ENVIRONMENT=production
MONIS_API_URL=
MONIS_STRAPI_URL=
# Staging browser prompt password; leave empty for production.
STAGING_GATE_PASSWORD=
# Dedicated Monis account for password login.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# A separate account for the invalid-password test.
NEGATIVE_TEST_USER_EMAIL=
NEGATIVE_TEST_USER_PASSWORD=
# Separate Monis test account on a public @mailinator.com inbox; anyone can read it.
MAILINATOR_TEST_EMAIL=
# Explicitly set to 1 to permit production account creation and email requests.
RUN_PRODUCTION_MUTATIONS=0
# HTTPS hostname that actually serves the observed email login link (never a regex).
AUTH_LINK_HOST=
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
